# Copy to main/.env and fill in values
# These are available at compile time via env!("VAR_NAME")

# WiFi credentials
WIFI_SSID=your_ssid
WIFI_PASSWORD=your_password

# MQTT
MQTT_ENDPOINT=mqtt://broker:1883
MQTT_USER=username
MQTT_PASS=password

# Build environment (set by env.sh, or export manually)
# LIBCLANG_PATH=
# PKG_CONFIG_PATH=
